# Supabase Configuration
# Create a free project at https://supabase.com and copy your project URL, anon key, and service role key.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Server-side only: required on Render/production server to bypass RLS and persist records to Supabase
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Paystack Payment Gateway Configuration (Stage 4)
# NEVER expose PAYSTACK_SECRET_KEY to frontend/Vite/GitHub.
# Get keys from Paystack Dashboard (https://dashboard.paystack.com/#/settings/developer)
# Test Mode keys start with pk_test_ and sk_test_
# Live Mode keys start with pk_live_ and sk_live_
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Gemini AI API Key (Server-side)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SMS Gateway Configuration (SMSLive247 / Termii)
# NEVER expose SMS API keys to frontend/Vite. All SMS are dispatched server-side.
SMS_PROVIDER="smslive247"
SMSLIVE247_API_KEY="your-smslive247-api-key"
SMSLIVE247_SENDER_ID="FINGEROFGOD"
# Or generic fallback variable names:
# SMS_API_KEY="your-smslive247-api-key"
# SMS_SENDER_ID="FINGEROFGOD"
# SMS_CHANNEL="generic"

# Application URL (Used for webhook callbacks and redirects)
APP_URL="https://your-applet-url.run.app"

# Banking Gateway & Direct Bank Transfer Webhook Configuration
# Used for server-side verification of direct bank transfers (Zenith Bank / Mono / Okra)
BANK_WEBHOOK_SECRET="bank_sec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OPEN_BANKING_PROVIDER="zenith_escrow_feed"

